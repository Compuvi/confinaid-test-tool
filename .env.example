# =============================================================================
# Confinaid Test Tool — Environment Variables
# =============================================================================
# Copy to .env and adjust. NEVER commit .env.
#
# Note: this file holds DEFAULTS only. The API secret key is never read from
# the environment — it is entered in the app and stored in the OS keychain.

# Pre-fills the API base URL field on the Connection page.
VITE_DEFAULT_API_BASE_URL=https://beta-api.confinaid.com
